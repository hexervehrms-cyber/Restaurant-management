# Database Configuration
# Supabase PostgreSQL Connection (transaction-mode pooler)
DATABASE_URL="postgresql://user:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Connection (session-mode pooler for migrations)
DIRECT_URL="postgresql://user:password@aws-region.pooler.supabase.com:5432/postgres"

# Firebase Client Configuration (from Firebase Console)
# Project: restaurant-management-d5c73
# Get these from Firebase Console → Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Test/Demo Credentials (Development Only)
# These are used for the login page helper card in development
# Primary test account
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=demo_password_123

# Secondary test account (for testing multiple users)
NEXT_PUBLIC_DEMO_EMAIL_2=test@example.com
NEXT_PUBLIC_DEMO_PASSWORD_2=demo_password_456
